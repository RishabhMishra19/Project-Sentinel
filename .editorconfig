root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true

[*.java]

# Keep code compact
ij_java_keep_blank_lines_in_code = 1
ij_java_keep_blank_lines_before_rbrace = 0
ij_java_blank_lines_after_class_header = 0

# ============================================================
# Imports
# ============================================================

# Never use wildcard imports
ij_java_class_count_to_use_import_on_demand = 9999
ij_java_names_count_to_use_import_on_demand = 9999
ij_java_packages_to_use_import_on_demand =

# Static imports after normal imports
ij_java_import_layout = |,java,javax,|,$*

# ============================================================
# Indentation
# ============================================================

ij_java_indent_size = 4
ij_java_continuation_indent_size = 4
ij_java_tab_size = 4
ij_java_use_tab_character = false

# ============================================================
# Braces
# ============================================================

ij_java_brace_style = end_of_line
ij_java_class_brace_style = end_of_line
ij_java_method_brace_style = end_of_line

# Always use braces
ij_java_if_brace_force = force
ij_java_for_brace_force = force
ij_java_while_brace_force = force
ij_java_dowhile_brace_force = force

# ============================================================
# Wrapping
# ============================================================

# Method calls
ij_java_method_call_chain_wrap = normal
ij_java_call_parameters_wrap = normal
ij_java_call_parameters_new_line_after_left_paren = false
ij_java_call_parameters_right_paren_on_new_line = false

# Method declarations
ij_java_method_parameters_wrap = normal
ij_java_method_parameters_new_line_after_left_paren = false
ij_java_method_parameters_right_paren_on_new_line = false

# Keep simple expressions together
ij_java_binary_operation_wrap = normal
ij_java_assignment_wrap = normal
ij_java_ternary_operation_wrap = normal

# ============================================================
# Alignment
# ============================================================

# Don't create huge visual gaps just to align things
ij_java_align_multiline_parameters = false
ij_java_align_multiline_parameters_in_calls = false
ij_java_align_multiline_for = false
ij_java_align_multiline_chained_methods = false
ij_java_align_multiline_binary_operation = false

# ============================================================
# Method / Class Layout
# ============================================================

# One blank line between logical sections
ij_java_blank_lines_around_method = 1
ij_java_blank_lines_around_field = 0

# Don't add unnecessary blank lines after opening braces
ij_java_blank_lines_after_class_header = 0

# ============================================================
# Comments
# ============================================================

ij_java_keep_first_column_comment = false
ij_java_keep_control_statement_in_one_line = false
ij_java_wrap_comments = true

# ============================================================
# JavaDoc
# ============================================================

ij_java_doc_align_param_comments = false
ij_java_doc_align_exception_comments = false
ij_java_doc_keep_empty_parameter = false
ij_java_doc_keep_empty_exception = false
ij_java_doc_keep_empty_return = false

# ============================================================
# Arrays / Collections
# ============================================================

ij_java_array_initializer_wrap = normal
ij_java_array_initializer_new_line_after_left_brace = false
ij_java_array_initializer_right_brace_on_new_line = false

# ============================================================
# Annotations
# ============================================================

ij_java_class_annotation_wrap = split_into_lines
ij_java_method_annotation_wrap = split_into_lines
ij_java_field_annotation_wrap = split_into_lines