{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "timeseries",
      "title": "Events / sec (ingest publish vs worker process)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(sentinel_ingest_events_published_total[1m]))",
          "legendFormat": "ingest published",
          "refId": "A"
        },
        {
          "expr": "sum(rate(sentinel_worker_events_processed_total[1m]))",
          "legendFormat": "worker processed",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Worker batch process time (avg seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(sentinel_worker_batch_process_seconds_sum[1m])) / clamp_min(sum(rate(sentinel_worker_batch_process_seconds_count[1m])), 1e-9)",
          "legendFormat": "avg batch time",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Worker avg batch size (events)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(sentinel_worker_batch_size_sum[1m])) / clamp_min(sum(rate(sentinel_worker_batch_size_count[1m])), 1e-9)",
          "legendFormat": "avg batch size",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ingest publish latency (avg seconds / request)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(sentinel_ingest_publish_seconds_sum[1m])) / clamp_min(sum(rate(sentinel_ingest_publish_seconds_count[1m])), 1e-9)",
          "legendFormat": "avg publish time",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Worker batch failures / sec",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" },
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(sentinel_worker_batches_failed_total[1m]))",
          "legendFormat": "failed batches",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Events processed (total)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "expr": "sum(sentinel_worker_events_processed_total)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Batches processed (total)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "expr": "sum(sentinel_worker_batches_processed_total)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Batches failed (total)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "expr": "sum(sentinel_worker_batches_failed_total)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Ingest events published (total)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "expr": "sum(sentinel_ingest_events_published_total)",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["sentinel", "pipeline"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
